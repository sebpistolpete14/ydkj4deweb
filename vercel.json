{
  "routes": [
    {
      "src": "/(.*)\\.dat",
      "headers": {
        "content-type": "application/x-shockwave-flash",
        "cache-control": "public, max-age=31536000, immutable"
      },
      "continue": true
    },
    {
      "src": "/lib/gen/(.*)",
      "headers": {
        "content-type": "application/x-shockwave-flash"
      },
      "continue": true
    }
  ]
}