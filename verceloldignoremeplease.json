{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/+mod/:path*",
      "destination": "/lib/mod/:path*"
    },
    {
      "source": "/%2Bmod/:path*",
      "destination": "/lib/mod/:path*"
    }
  ],
  "headers": [
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/x-shockwave-flash"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/(.*).xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/xml; charset=iso-8859-1"
        }
      ]
    }
  ]
}